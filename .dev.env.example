# Local settings for ./dev. Copy this file to .dev.env and adjust it.
# .dev.env is machine-specific and not committed.

# CODESYS.exe of the installation, forward slashes work.
CODESYS_EXE="C:/Path/To/CODESYS/Common/CODESYS.exe"

# Profile name exactly as shown in the CODESYS start menu entry,
# or the file name in <install folder>/CODESYS/Profiles without ".profile.xml".
CODESYS_PROFILE="CODESYS V3.5 SP22 Patch 3"
